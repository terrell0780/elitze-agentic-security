# Runtime configuration for ELITZE · Agentic Security
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
ELITZE_INTERNAL_API_KEY=replace-with-a-long-random-secret
ELITZE_CONTAINMENT_EXECUTOR_URL=
ELITZE_CONTAINMENT_EXECUTOR_KEY=
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=10000
NODE_ENV=production
