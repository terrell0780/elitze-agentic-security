# Runtime configuration for ELITZE
NEXT_PUBLIC_SITE_URL=https://elitze.info
ELITZE_CONTACT_EMAIL=tsh_cook@hotmail.com
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Runtime also accepts PGHOST/PGPORT/PGUSER/PGPASSWORD/PGDATABASE when DATABASE_URL is absent.
# For managed Postgres using component variables, set DATABASE_SSL=require when TLS is required.
ELITZE_INTERNAL_API_KEY=replace-with-a-long-random-secret
ELITZE_EVIDENCE_SIGNING_SECRET=replace-with-a-long-random-secret
ELITZE_WORKLOAD_TOKEN_SIGNING_SECRET=replace-with-a-long-random-secret-at-least-32-chars
ELITZE_WORKLOAD_TOKEN_TTL_SECONDS=300
ELITZE_MCP_GATEWAY_CREDENTIAL=
ELITZE_CONTAINMENT_EXECUTOR_URL=
ELITZE_CONTAINMENT_EXECUTOR_KEY=
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=10000
NODE_ENV=production
ELITZE_TRUST_PROXY=false

# Email identity. Store real values only in the deployment secret manager.
RESEND_API_KEY=
RESEND_FROM=

# Governed AI generation. URL must point to an authorized OpenAI-compatible chat endpoint.
# No model response is generated when this is absent.
ELITZE_AI_GATEWAY_URL=
ELITZE_AI_GATEWAY_TOKEN=
ELITZE_AI_MODEL=

# Team collaboration bootstrap. This is a bootstrap/session boundary, not a substitute for enterprise OIDC/MFA.
# Store real values only in the deployment secret manager; never commit them.
ELITZE_TEAM_BOOTSTRAP_KEY=replace-with-a-long-random-secret
ELITZE_TEAM_SESSION_SECRET=replace-with-a-long-random-secret

# Enterprise security connectors. Store real values in the deployment secret manager.
ELITZE_GRAPH_SECURITY_URL=
ELITZE_GRAPH_SECURITY_TOKEN=
ELITZE_OKTA_SYSTEM_LOG_URL=
ELITZE_OKTA_SYSTEM_LOG_TOKEN=
ELITZE_GITHUB_SECURITY_URL=
ELITZE_GITHUB_SECURITY_TOKEN=
ELITZE_THREAT_INTEL_URL=
ELITZE_THREAT_INTEL_TOKEN=
ELITZE_RESPONSE_URL=
ELITZE_RESPONSE_TOKEN=
ELITZE_CLOUD_SECURITY_URL=
ELITZE_CLOUD_SECURITY_TOKEN=
ELITZE_ENDPOINT_SECURITY_URL=
ELITZE_ENDPOINT_SECURITY_TOKEN=
ELITZE_NETWORK_SECURITY_URL=
ELITZE_NETWORK_SECURITY_TOKEN=
ELITZE_INGEST_HMAC_SECRET=

# ELITZE GitHub Control MCP. Never commit a real token.
GITHUB_TOKEN=
GITHUB_REPOSITORY=terrell0780/elitze-agentic-security
# Keep false unless repository mutations are explicitly authorized.
ELITZE_GITHUB_MCP_WRITE=false

# Live AWS observation. Store real values only in the deployment secret manager.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

# Authorized Google Search Console / GA4 data access is configured outside the repository.
# Never commit GOOGLE_ACCESS_TOKEN or any other credential.
GOOGLE_ACCESS_TOKEN=

# Authentication encryption and enterprise identity providers. Store real values only in the deployment secret manager.
ELITZE_AUTH_ENCRYPTION_KEY=replace-with-a-64-character-hex-secret
ELITZE_OIDC_ISSUER_URL=
ELITZE_OIDC_CLIENT_ID=
ELITZE_OIDC_CLIENT_SECRET=
ELITZE_OIDC_SCOPES=openid profile email

# SAML 2.0. The IdP signing certificate is required for response signature validation.
ELITZE_SAML_IDP_ENTITY_ID=
ELITZE_SAML_IDP_SSO_URL=
ELITZE_SAML_IDP_CERTIFICATE=
# Optional SP request signing. Set both values together to sign AuthnRequests.
ELITZE_SAML_SP_ENTITY_ID=https://elitze.info/api/auth/saml/metadata
ELITZE_SAML_ACS_URL=https://elitze.info/api/auth/saml/callback
ELITZE_SAML_SP_PRIVATE_KEY=
ELITZE_SAML_SP_CERTIFICATE=

ELITZE_WEBAUTHN_RP_ID=elitze.info
ELITZE_WEBAUTHN_RP_NAME=ELITZE Agentic Security
ELITZE_WEBAUTHN_ORIGIN=https://elitze.info

ELITZE_ALLOWED_ORIGINS=https://elitze.info

# Autonomous Analyst security source fabric. Store real values only in the deployment secret manager.
ELITZE_OPENCTI_URL=
ELITZE_OPENCTI_TOKEN=
ELITZE_MISP_URL=
ELITZE_MISP_TOKEN=
ELITZE_THEHIVE_URL=
ELITZE_THEHIVE_TOKEN=
ELITZE_THEHIVE_STATUS_PATH=/api/v1/status
ELITZE_WAZUH_URL=
ELITZE_WAZUH_USERNAME=
ELITZE_WAZUH_PASSWORD=
ELITZE_VELOCIRAPTOR_GRPC_TARGET=
ELITZE_FLEETDM_URL=
ELITZE_FLEETDM_TOKEN=
ELITZE_GREENBONE_URL=
ELITZE_NUCLEI_RUNNER_URL=
ELITZE_GITHUB_ADVISORIES_URL=https://api.github.com/advisories
ELITZE_GITHUB_ADVISORIES_TOKEN=
ELITZE_SIGMA_SOURCE_URL=
ELITZE_YARA_SOURCE_URL=
