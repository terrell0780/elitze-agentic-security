# Enterprise Docker deployment example.
# Do not commit real credentials here.
NEXT_PUBLIC_SITE_URL=https://security.example.com
ELITZE_BIND_ADDRESS=127.0.0.1
ELITZE_HTTP_PORT=3000
ELITZE_TRUST_PROXY=true
ELITZE_IMAGE=elitze-agentic-security:enterprise
ELITZE_AI_GATEWAY_URL=https://model-gateway.example.com
ELITZE_AI_MODEL=enterprise-authorized-model
ELITZE_AI_GATEWAY_REQUIRE_AUTH=true
ELITZE_AI_GATEWAY_TOKEN=
ELITZE_DATABASE_URL=postgresql://USER:PASSWORD@PRIVATE_DB_HOST:5432/elitze
