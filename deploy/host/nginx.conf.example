# ELITZE Agentic Security — reverse proxy example (TLS terminated at nginx).
# Place in /etc/nginx/sites-available/elitze and symlink into sites-enabled.

upstream elitze_app {
    server 127.0.0.1:3000;
    keepalive 32;
}

server {
    listen 80;
    server_name elitze.ca www.elitze.ca;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name elitze.ca www.elitze.ca;

    ssl_certificate     /etc/letsencrypt/live/elitze.ca/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/elitze.ca/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    client_max_body_size 10m;

    # Application security headers are already emitted by the app (next.config.ts).
    location / {
        proxy_pass http://elitze_app;
        proxy_http_version 1.1;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location /_next/static/ {
        proxy_pass http://elitze_app;
        proxy_cache_valid 200 365d;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
}
